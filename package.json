{
  "name": "openclaw-plugin-speko",
  "version": "0.1.2",
  "description": "Speko provider plugin for OpenClaw: benchmark-routed LLM, speech and transcription behind one key.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config ./vitest.config.ts",
    "validate": "npm run build && clawhub package validate . --out .clawhub-validation"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "clawhub": "latest",
    "openclaw": "latest",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "clawhubSpec": "clawhub:openclaw-plugin-speko",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.7.1-2"
    },
    "compat": {
      "pluginApi": ">=2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2"
    },
    "release": {
      "publishToClawHub": true
    }
  },
  "pluginInspector": {
    "version": 1,
    "plugin": {
      "id": "speko",
      "priority": "high",
      "seams": [
        "plugin-runtime"
      ],
      "sourceRoot": ".",
      "expect": {
        "registrations": [
          "registerProvider",
          "registerModelCatalogProvider",
          "registerSpeechProvider",
          "registerMediaUnderstandingProvider",
          "registerTool"
        ]
      }
    }
  },
  "license": "MIT",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "speko",
    "tts",
    "stt",
    "speech",
    "transcription",
    "voice",
    "router"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpekoAI/openclaw-speko.git"
  },
  "homepage": "https://github.com/SpekoAI/openclaw-speko#readme",
  "bugs": {
    "url": "https://github.com/SpekoAI/openclaw-speko/issues"
  },
  "dependencies": {
    "typebox": "^1.3.3"
  }
}
